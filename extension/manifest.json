{
  "manifest_version": 3,
  "name": "CaughtUp — AI Inbox Agent",
  "version": "0.7.0",
  "description": "Automatically process forwarded Gmail, review safe replies, and send through your Gmail account.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CaughtUp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": ["https://xkrpxvswdkreglmefuot.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
